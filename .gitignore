# Android release signing — NEVER commit
android/keystore.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Android build artifacts
android/.gradle/
android/local.properties
android/app/release/
android/app/build/

# Instagram: se sube solo lo que igual es público (posts, reels, logos, historias).
# Estrategia, presupuesto y documentos internos quedan fuera: el repo es público.
[Ii]nstagram/5 Documentos/
[Ii]nstagram/_sistema/_vista.html

# Notas de trabajo internas (análisis de riesgos, decisiones); el repo es público
notas/

# Generador de reels: archivos que se regeneran (no subir)
[Ii]nstagram/_sistema/reels/**/__pycache__/
[Ii]nstagram/_sistema/reels/**/*_vista_previa.png
[Ii]nstagram/_sistema/reels/**/*.wav

# Reels con tu cara y tu voz: el mp4 final pesa ~50 MB y se regenera con
# remotion/scripts/final.py. Caption y portada sí se suben, como en los demás.
[Ii]nstagram/2 Reels/15 Desde donde quieras/*.mp4
[Ii]nstagram/_sistema/remotion/scripts/__pycache__/
